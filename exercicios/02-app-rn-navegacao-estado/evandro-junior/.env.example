# Copia esse arquivo pra .env (sem .example).
# .env está no .gitignore — NUNCA comite tokens reais.
#
# Gerar em: https://www.themoviedb.org/settings/api
#
# O valor é lido da variável de ambiente TMDB_API_KEY do seu shell
# (o Expo expande ${VAR} no .env), então o token não fica gravado no arquivo:
#   export TMDB_API_KEY=...
#
# Aceita 2 formatos (o starter detecta automático):
#   - API Key v3 (32 chars hex)
#   - API Read Access Token v4 (JWT longo, eyJhbGc...)

EXPO_PUBLIC_TMDB_TOKEN=${TMDB_API_KEY}
